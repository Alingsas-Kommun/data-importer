{
    "name": "michaelclaesson/data-importer",
    "type": "wordpress-plugin",
    "autoload": {
        "psr-4": {
            "DataImporter\\": "src/php/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DataImporter\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "test:verbose": "vendor/bin/phpunit --testdox",
        "test:list": "vendor/bin/phpunit --list-tests"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6"
    },
    "authors": [
        {
            "name": "Michael Claesson",
            "email": "michael.claesson@consid.se"
        }
    ],
    "minimum-stability": "dev"
}
